+    def _validate_option_constraints(self, ctx: Context) -> None:
+        params_by_name: dict[str, Parameter] = {
+            param.name: param
+            for param in self.get_params(ctx)
+            if param.name is not None
+        }
+        explicit_sources = {
+            ParameterSource.COMMANDLINE,
+            ParameterSource.ENVIRONMENT,
+        }
+
+        def _is_explicit(param_name: str) -> bool:
+            return ctx.get_parameter_source(param_name) in explicit_sources
+
+        def _is_satisfied(param_name: str) -> bool:
+            source = ctx.get_parameter_source(param_name)
+            if source in (
+                ParameterSource.COMMANDLINE,
+                ParameterSource.ENVIRONMENT,
+                ParameterSource.DEFAULT_MAP,
+            ):
+                return True
+            if source == ParameterSource.DEFAULT:
+                val = ctx.params.get(param_name)
+                return val is not None and val is not False and val != () and val != []
+            return False
+
+        for param in self.get_params(ctx):
+            if not isinstance(param, Option) or param.name is None:
+                continue
+            if not _is_explicit(param.name):
+                continue
+
+            for other_name in param.conflicts_with:
+                if other_name != param.name and _is_explicit(other_name):
+                    other_param = params_by_name.get(other_name)
+                    other_hint = (
+                        other_param.get_error_hint(ctx)
+                        if other_param is not None
+                        else f"'{other_name}'"
+                    )
+                    raise UsageError(
+                        _("Illegal usage: {opt} is mutually exclusive with {other}.").format(
+                            opt=param.get_error_hint(ctx),
+                            other=other_hint,
+                        ),
+                        ctx=ctx,
+                    )
+
+            for req_name in param.requires:
+                if req_name != param.name and not _is_satisfied(req_name):
+                    req_param = params_by_name.get(req_name)
+                    req_hint = (
+                        req_param.get_error_hint(ctx)
+                        if req_param is not None
+                        else f"'{req_name}'"
+                    )
+                    raise UsageError(
+                        _("Illegal usage: {opt} requires {req}.").format(
+                            opt=param.get_error_hint(ctx),
+                            req=req_hint,
+                        ),
+                        ctx=ctx,
+                    )
 
